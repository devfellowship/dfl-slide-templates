# Supabase project URL (required — hosts auth + publish edge function)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (required — client-side auth)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Umami analytics website id (build time). Leave empty: no tag is rendered.
VITE_UMAMI_WEBSITE_ID=
