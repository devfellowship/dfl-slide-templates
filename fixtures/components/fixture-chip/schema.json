{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:dfl-slide-templates:component:fixture-chip",
  "title": "Fixture chip — overlay component slots",
  "description": "GENERATED from config.yaml next to this file by scripts/component-format.mjs (npm run gen:component-schema). Do not edit by hand: CI fails when this file drifts from config.yaml. This is the slot contract that Lesson Studio, the studio MCP tools and the long-tutorial skill read.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "term"
  ],
  "properties": {
    "type": {
      "type": "string",
      "enum": [
        "conceito",
        "ferramenta",
        "ia",
        "giria",
        "codigo",
        "noticia"
      ],
      "default": "conceito",
      "description": "Picks the icon when there is no image.",
      "x-dfl-slot-type": "select"
    },
    "term": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^\\s*\\S+(\\s+\\S+){0,2}\\s*$",
      "description": "The term, 1 to 3 words.",
      "x-dfl-slot-type": "text",
      "x-dfl-max-words": 3
    },
    "image": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048,
      "pattern": "^https://([a-z0-9-]+\\.)*(devfellowship\\.com|supabase\\.co|s3\\.amazonaws\\.com)(/[^\\s\"'<>\\\\]*)?$",
      "description": "Optional https image (a logo or a screen crop) on the DFL media allowlist. When absent, the type icon shows.",
      "x-dfl-slot-type": "image"
    }
  },
  "x-dfl-component": {
    "id": "fixture-chip",
    "name": "Fixture chip",
    "version": "1.0.0",
    "box": {
      "width": 480,
      "height": 96
    },
    "anchors": [
      "bottom-left",
      "bottom-right",
      "top-left",
      "top-right",
      "lower-third"
    ],
    "default_anchor": "bottom-left",
    "duration_ms": 4000,
    "view_flags": {
      "type": [
        "type__conceito",
        "type__ferramenta",
        "type__ia",
        "type__giria",
        "type__codigo",
        "type__noticia"
      ]
    }
  }
}
